# Variáveis do serviço no Railway (Settings → Variables). Nunca coloque os valores reais no GitHub.
DATABASE_URL=${{Postgres.DATABASE_URL}}
GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
# Google Agenda: a "chave secreta do cliente" do mesmo ID OAuth acima. Sem ela, a opção de conectar a agenda não aparece.
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Endereço público do sistema (opcional; no Railway o domínio gerado é usado sozinho). Ex.: https://tarefas.darmand.com.br
APP_URL=
ALLOWED_DOMAIN=darmand.com.br
# Gestores fixos (separados por vírgula). Outros gestores podem ser definidos na tela Equipe.
ADMIN_EMAILS=marcello@darmand.com.br
SESSION_SECRET=gere-um-texto-aleatorio-de-64-caracteres
# Narrar (IA): chave da API da Anthropic, criada em https://platform.claude.com (Settings → API Keys).
# Sem ela, o botão Narrar avisa que a IA não está configurada; o resto do sistema funciona normalmente.
ANTHROPIC_API_KEY=sk-ant-...
# Módulos do portal (vendas, produto, pessoas): a tarefa diária grava os dados das lojas em /api/ingest com este token.
# Texto aleatório longo, diferente do SESSION_SECRET. Sem ele, ninguém consegue gravar dados de vendas.
INGEST_TOKEN=gere-outro-texto-aleatorio-de-64-caracteres
# Mudança do portal antigo (só uma vez): endereço PÚBLICO do Postgres do portal antigo (Railway → Postgres → Variables → DATABASE_PUBLIC_URL).
# Na primeira subida com ela, tudo é copiado para o banco próprio: vendas, metas, comunicados, vínculos de gerentes. Depois pode ser apagada.
PORTAL_DATABASE_URL=
