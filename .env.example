# Variáveis do serviço no Railway (Settings → Variables). Nunca coloque os valores reais no GitHub.
DATABASE_URL=${{Postgres.DATABASE_URL}}
GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
ALLOWED_DOMAIN=darmand.com.br
# Gestores fixos (separados por vírgula). Outros gestores podem ser definidos na tela Equipe.
ADMIN_EMAILS=marcello@darmand.com.br
SESSION_SECRET=gere-um-texto-aleatorio-de-64-caracteres
# Narrar (IA): chave da API da Anthropic, criada em https://platform.claude.com (Settings → API Keys).
# Sem ela, o botão Narrar avisa que a IA não está configurada; o resto do sistema funciona normalmente.
ANTHROPIC_API_KEY=sk-ant-...
